      "groupIds": [],
      "frameId": null,
      "index": "bEC",
      "roundness": null,
      "seed": 1009340463,
      "version": 142,
      "versionNonce": 681594959,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788861021787,
      "link": null,
      "locked": false,
      "text": "public class OrderService : IOrderService\n{\n    private readonly AppDbContext _dbContext;  // ← 注入 DbContext\n    public OrderService(AppDbContext dbContext)\n    {\n        _dbContext = dbContext;\n    }\n}\n\npublic class PaymentService : IPaymentService\n{\n    private readonly AppDbContext _dbContext;  // ← 注入 DbContext\n    public PaymentService(AppDbContext dbContext)\n    {\n        _dbContext = dbContext;\n    }\n}\n\npublic class EmailService : IEmailService\n{\n    private readonly AppDbContext _dbContext;  // ← 注入 DbContext\n    public EmailService(AppDbContext dbContext)\n    {\n        _dbContext = dbContext;\n    }\n}",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class OrderService : IOrderService\n{\n    private readonly AppDbContext _dbContext;  // ← 注入 DbContext\n    public OrderService(AppDbContext dbContext)\n    {\n        _dbContext = dbContext;\n    }\n}\n\npublic class PaymentService : IPaymentService\n{\n    private readonly AppDbContext _dbContext;  // ← 注入 DbContext\n    public PaymentService(AppDbContext dbContext)\n    {\n        _dbContext = dbContext;\n    }\n}\n\npublic class EmailService : IEmailService\n{\n    private readonly AppDbContext _dbContext;  // ← 注入 DbContext\n    public EmailService(AppDbContext dbContext)\n    {\n        _dbContext = dbContext;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Y4y7BI07nV9qqtj4Q2FHc",
      "type": "text",
      "x": 2984.3005634351853,
      "y": 578.9484718700091,
      "width": 394,
      "height": 320,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bED",
      "roundness": null,
      "seed": 771910287,
      "version": 208,
      "versionNonce": 968661761,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788861075307,
      "link": null,
      "locked": false,
      "text": "public class OrderController : Controller\n{\n    private readonly IOrderService _orderService;\n    private readonly IPaymentService _paymentService;\n    private readonly IEmailService _emailService;\n    \n    public OrderController(\n        IOrderService orderService,\n        IPaymentService paymentService,\n        IEmailService emailService)\n    {\n        _orderService = orderService;\n        _paymentService = paymentService;\n        _emailService = emailService;\n    }\n}",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class OrderController : Controller\n{\n    private readonly IOrderService _orderService;\n    private readonly IPaymentService _paymentService;\n    private readonly IEmailService _emailService;\n    \n    public OrderController(\n        IOrderService orderService,\n        IPaymentService paymentService,\n        IEmailService emailService)\n    {\n        _orderService = orderService;\n        _paymentService = paymentService;\n        _emailService = emailService;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "XMPu75ng9UAUwLMrb6QDj",
      "type": "text",
      "x": 2400.0411294834994,
      "y": 1174.1288685855582,
      "width": 427,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEE",
      "roundness": null,
      "seed": 1476329295,
      "version": 97,
      "versionNonce": 626185665,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788861018241,
      "link": null,
      "locked": false,
      "text": "请求进来\n  ├─ 创建 OrderService\n  │    └─ new AppDbContext()  ← 对象 A\n  ├─ 创建 PaymentService\n  │    └─ new AppDbContext()  ← 对象 B（和 A 不同！）\n  └─ 创建 EmailService\n       └─ new AppDbContext()  ← 对象 C（又不同！）\n\nOrderService 用 A 添加了 Order\nPaymentService 用 B 去查询 Order\n  → 查不到！因为 A 还没 SaveChanges，B 不知道 A 的存在\n  → ❌ 业务逻辑全乱",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "请求进来\n  ├─ 创建 OrderService\n  │    └─ new AppDbContext()  ← 对象 A\n  ├─ 创建 PaymentService\n  │    └─ new AppDbContext()  ← 对象 B（和 A 不同！）\n  └─ 创建 EmailService\n       └─ new AppDbContext()  ← 对象 C（又不同！）\n\nOrderService 用 A 添加了 Order\nPaymentService 用 B 去查询 Order\n  → 查不到！因为 A 还没 SaveChanges，B 不知道 A 的存在\n  → ❌ 业务逻辑全乱",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "BslqQZLsEiZTzplDp-4JA",
      "type": "text",
      "x": 2974.3576106027795,
      "y": 1174.1288685855582,
      "width": 430,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEF",
      "roundness": null,
      "seed": 113664111,
      "version": 110,
      "versionNonce": 852784545,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788861018241,
      "link": null,
      "locked": false,
      "text": "请求进来\n  ├─ 先创建 AppDbContext 实例 X（请求开始时就创建了）\n  ├─ 创建 OrderService\n  │    └─ 复用 X\n  ├─ 创建 PaymentService\n  │    └─ 复用 X（同一个！）\n  └─ 创建 EmailService\n       └─ 复用 X（还是同一个！）\n\nOrderService 用 X 添加了 Order\nPaymentService 用 X 去查询 Order\n  → 查到了！因为 X 跟踪了所有更改\n  → ✅ 完美！",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "请求进来\n  ├─ 先创建 AppDbContext 实例 X（请求开始时就创建了）\n  ├─ 创建 OrderService\n  │    └─ 复用 X\n  ├─ 创建 PaymentService\n  │    └─ 复用 X（同一个！）\n  └─ 创建 EmailService\n       └─ 复用 X（还是同一个！）\n\nOrderService 用 X 添加了 Order\nPaymentService 用 X 去查询 Order\n  → 查到了！因为 X 跟踪了所有更改\n  → ✅ 完美！",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
