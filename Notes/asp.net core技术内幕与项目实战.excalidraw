    {
      "id": "Mkq9pipPLZRyXqEWw4E9Y",
      "type": "text",
      "x": 3649.1435872919037,
      "y": 715.2478890069558,
      "width": 562,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGU",
      "roundness": null,
      "seed": 1768218440,
      "version": 47,
      "versionNonce": 1652882760,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788959461771,
      "link": null,
      "locked": false,
      "text": "public static IQueryable<Order> WhereActive(this IQueryable<Order> query)\n {\n        return query.Where(o => !o.IsDeleted && o.Status == OrderStatus.Paid);\n }",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public static IQueryable<Order> WhereActive(this IQueryable<Order> query)\n {\n        return query.Where(o => !o.IsDeleted && o.Status == OrderStatus.Paid);\n }",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
