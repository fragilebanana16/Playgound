      "groupIds": [
        "AY_TTRRn7IbH9bMJRNK2s"
      ],
      "frameId": null,
      "index": "bAQV",
      "roundness": null,
      "seed": 150565002,
      "version": 328,
      "versionNonce": 1678195030,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788840010010,
      "link": null,
      "locked": false,
      "text": "【调用 ProcessAsync()】\n        │\n   (当前主线程) ───────> 1. 首次调用 MoveNext()\n                               │\n                      (遇到 await，未完成，挂起 return)\n                               │\n                       等待硬件 / IO / 定时器完成...\n                               │\n   (线程池 / UI线程) ───> 2. 回调触发第二次 MoveNext()",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "【调用 ProcessAsync()】\n        │\n   (当前主线程) ───────> 1. 首次调用 MoveNext()\n                               │\n                      (遇到 await，未完成，挂起 return)\n                               │\n                       等待硬件 / IO / 定时器完成...\n                               │\n   (线程池 / UI线程) ───> 2. 回调触发第二次 MoveNext()",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
