      "text": "内置的 Action / Func 泛型委托最多支持 16 个参数：",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "内置的 Action / Func 泛型委托最多支持 16 个参数：",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "GvO9R5G2rXjC_BfeL1u8T",
      "type": "text",
      "x": 1032.4373148433685,
      "y": 2709.4689920566784,
      "width": 279,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAz",
      "roundness": null,
      "seed": 1918922511,
      "version": 184,
      "versionNonce": 138893953,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788853138616,
      "link": null,
      "locked": false,
      "text": "Action<T1, T2, ..., T16> \n\nFunc<T1, T2, ..., T16, TResult>",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Action<T1, T2, ..., T16> \n\nFunc<T1, T2, ..., T16, TResult>",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pMZR3PhDeccDxV6CFaZ9R",
      "type": "text",
      "x": 1413.0718717725913,
      "y": 2869.6316058373914,
      "width": 427.518565330085,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bB1",
      "roundness": null,
      "seed": 18885633,
      "version": 190,
      "versionNonce": 1726344993,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "S9oroI2RlfoEN1lOvFLAf",
          "type": "arrow"
        }
      ],
      "updated": 1788853135311,
      "link": null,
      "locked": false,
      "text": "public static IEnumerable<T> Where<T>(\n    this IEnumerable<T> source,  // 扩展方法\n    Func<T, bool> predicate\n)\n{\n\n}",
      "fontSize": 16,
