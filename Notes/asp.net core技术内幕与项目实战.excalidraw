    {
      "id": "MonbZ5tOI0niStTy5T7GJ",
      "type": "text",
      "x": 2461.874275486123,
      "y": 2896.882111262344,
      "width": 224,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
