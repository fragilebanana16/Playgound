    {
      "id": "Xm2ZovvK-THsHYyTS6rZF",
      "type": "text",
      "x": 2506.112298436219,
      "y": 2552.865353544309,
      "width": 357,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffffff",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
