      "text": "modelBuilder.Entity<Blog>()\n    .HasMany(b => b.Posts)      // Blog 有 Many 个 Post\n    .WithOne(p => p.Blog)       // Post 属于 One 个 Blog\n    .HasForeignKey(p => p.BlogId);",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "modelBuilder.Entity<Blog>()\n    .HasMany(b => b.Posts)      // Blog 有 Many 个 Post\n    .WithOne(p => p.Blog)       // Post 属于 One 个 Blog\n    .HasForeignKey(p => p.BlogId);",
