    {
      "id": "XeXjpfSW_X27blSBuclju",
      "type": "text",
      "x": 990.1720945546524,
      "y": 1784.0753205115423,
      "width": 483,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
