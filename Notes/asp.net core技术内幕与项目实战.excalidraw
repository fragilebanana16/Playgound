      "isDeleted": false,
      "boundElements": null,
      "updated": 1788861075307,
      "link": null,
      "locked": false,
      "text": "public class OrderController : Controller\n{\n    private readonly IOrderService _orderService;\n    private readonly IPaymentService _paymentService;\n    private readonly IEmailService _emailService;\n    \n    public OrderController(\n        IOrderService orderService,\n        IPaymentService paymentService,\n        IEmailService emailService)\n    {\n        _orderService = orderService;\n        _paymentService = paymentService;\n        _emailService = emailService;\n    }\n}",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public class OrderController : Controller\n{\n    private readonly IOrderService _orderService;\n    private readonly IPaymentService _paymentService;\n    private readonly IEmailService _emailService;\n    \n    public OrderController(\n        IOrderService orderService,\n        IPaymentService paymentService,\n        IEmailService emailService)\n    {\n        _orderService = orderService;\n        _paymentService = paymentService;\n        _emailService = emailService;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "XMPu75ng9UAUwLMrb6QDj",
      "type": "text",
      "x": 2400.0411294834994,
      "y": 1174.1288685855582,
      "width": 427,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEE",
      "roundness": null,
      "seed": 1476329295,
      "version": 97,
      "versionNonce": 626185665,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788861018241,
      "link": null,
      "locked": false,
      "text": "请求进来\n  ├─ 创建 OrderService\n  │    └─ new AppDbContext()  ← 对象 A\n  ├─ 创建 PaymentService\n  │    └─ new AppDbContext()  ← 对象 B（和 A 不同！）\n  └─ 创建 EmailService\n       └─ new AppDbContext()  ← 对象 C（又不同！）\n\nOrderService 用 A 添加了 Order\nPaymentService 用 B 去查询 Order\n  → 查不到！因为 A 还没 SaveChanges，B 不知道 A 的存在\n  → ❌ 业务逻辑全乱",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "请求进来\n  ├─ 创建 OrderService\n  │    └─ new AppDbContext()  ← 对象 A\n  ├─ 创建 PaymentService\n  │    └─ new AppDbContext()  ← 对象 B（和 A 不同！）\n  └─ 创建 EmailService\n       └─ new AppDbContext()  ← 对象 C（又不同！）\n\nOrderService 用 A 添加了 Order\nPaymentService 用 B 去查询 Order\n  → 查不到！因为 A 还没 SaveChanges，B 不知道 A 的存在\n  → ❌ 业务逻辑全乱",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "BslqQZLsEiZTzplDp-4JA",
      "type": "text",
      "x": 2974.3576106027795,
      "y": 1174.1288685855582,
      "width": 430,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
