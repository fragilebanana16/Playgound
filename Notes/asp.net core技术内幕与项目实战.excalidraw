    {
      "id": "odN2Fc-vUpb375VLLSAMp",
      "type": "text",
      "x": 2396.956410615552,
      "y": 578.9484718700091,
      "width": 493,
      "height": 520,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
