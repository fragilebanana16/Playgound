      "updated": 1788923909480,
      "link": null,
      "locked": false,
      "text": "// 1. 定义配置类\npublic class MySettings {\n    public int RefreshInterval { get; set; }\n}\n\n// 2. 注册（Startup/Program.cs）\nbuilder.Services.Configure<MySettings>(\n    builder.Configuration.GetSection(\"MySettings\")\n);",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// 1. 定义配置类\npublic class MySettings {\n    public int RefreshInterval { get; set; }\n}\n\n// 2. 注册（Startup/Program.cs）\nbuilder.Services.Configure<MySettings>(\n    builder.Configuration.GetSection(\"MySettings\")\n);",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
