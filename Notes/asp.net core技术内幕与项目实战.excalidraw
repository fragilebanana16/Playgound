      "version": 338,
      "versionNonce": 533751009,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "Z0QBCZMSZruUu-eMKE14z",
          "type": "arrow"
        },
        {
          "id": "ULVBr9I-T3WFz3ZXkU3Fk",
          "type": "arrow"
        },
        {
          "id": "BfdLKmP6ghLleBuk8j0B2",
          "type": "arrow"
        },
        {
          "id": "tewxCtfj1LL2YiC1k0X-S",
          "type": "arrow"
        },
        {
          "id": "2EQPm39QFb2Kj58iooy4P",
