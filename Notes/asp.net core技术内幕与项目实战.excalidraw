    {
      "id": "rdSInl97lAcZC01hSETGJ",
      "type": "text",
      "x": 1022.6081353683644,
      "y": 2457.196760697872,
      "width": 544,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
