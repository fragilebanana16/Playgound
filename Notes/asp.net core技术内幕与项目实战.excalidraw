          "type": "arrow"
        }
      ],
      "updated": 1789011209624,
      "link": null,
      "locked": false,
      "text": "IEnumerable 是“内存里筛选数据”          --- 客户端评估\n\nIQueryable 是“数据库里筛选数据”         --- 服务端评估",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IEnumerable 是“内存里筛选数据”          --- 客户端评估\n\nIQueryable 是“数据库里筛选数据”         --- 服务端评估",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
