      "link": null,
      "locked": false,
      "text": "无状态且全局共享      → Singleton\n有状态且和请求绑定  → Scoped\n轻量级、用完即弃      → Transient",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "无状态且全局共享      → Singleton\n有状态且和请求绑定  → Scoped\n轻量级、用完即弃      → Transient",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
