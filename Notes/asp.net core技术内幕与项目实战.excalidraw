      "originalText": "把 Configuration[\"ConnectionStrings:Default\"] 这种字符串硬编码，变成注入一个 DatabaseOptions 类，里面有个 DefaultConnection 属性",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "vPaau-oGOHr-0VECfkxrV",
