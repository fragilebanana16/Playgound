    },
    {
      "id": "GU4bJpGO-6R4pxwAvyCwQ",
      "type": "text",
      "x": 3647.8686186376735,
      "y": 2249.0662336610126,
      "width": 140,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
