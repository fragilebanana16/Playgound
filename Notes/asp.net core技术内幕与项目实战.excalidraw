    },
    {
      "id": "-kFC1h9XFk75lgCMsZDZX",
      "type": "text",
      "x": 1150.345192043412,
      "y": 4838.481517191925,
      "width": 410,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEA",
      "roundness": null,
      "seed": 22421601,
      "version": 81,
      "versionNonce": 727014721,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788858602580,
      "link": null,
      "locked": false,
      "text": "// 查询语法\nvar query = from student in students\n            orderby student.Grade descending, student.Name\n            select student;\n\n// 方法语法\nvar query = students\n    .OrderByDescending(s => s.Grade)\n    .ThenBy(s => s.Name);",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// 查询语法\nvar query = from student in students\n            orderby student.Grade descending, student.Name\n            select student;\n\n// 方法语法\nvar query = students\n    .OrderByDescending(s => s.Grade)\n    .ThenBy(s => s.Name);",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
