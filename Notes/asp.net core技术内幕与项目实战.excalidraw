      "labelPosition": null
    },
    {
      "id": "rdSInl97lAcZC01hSETGJ",
      "type": "text",
      "x": 1022.6081353683644,
      "y": 2457.196760697872,
      "width": 544,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAj",
      "roundness": null,
      "seed": 848755722,
      "version": 133,
      "versionNonce": 578036618,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "qUEzg2bdBXOuyHdd76SLO",
          "type": "arrow"
        }
      ],
      "updated": 1788840382393,
      "link": null,
      "locked": false,
      "text": "虽然 await 前后可能是不同的线程\n线程 1 运行到 await，把当前状态机的局部变量存好后，立即 return 退出了\n线程 2 在未来的某个时间点被唤醒，接管状态机，继续往下跑",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "虽然 await 前后可能是不同的线程\n线程 1 运行到 await，把当前状态机的局部变量存好后，立即 return 退出了\n线程 2 在未来的某个时间点被唤醒，接管状态机，继续往下跑",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
