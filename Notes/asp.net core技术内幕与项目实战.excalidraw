    },
    {
      "id": "_ulVvU8b51Q15lHftsCxy",
      "type": "text",
      "x": 3634.0336974471675,
      "y": 969.8804247396807,
      "width": 827.2032428043989,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGW",
      "roundness": null,
      "seed": 2068309048,
      "version": 222,
      "versionNonce": 10137236,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789011202581,
      "link": null,
      "locked": false,
      "text": "DataReader（流式读取）：只进不退的管道流。从数据库拉取数据时，读一条扔一条，内存里永远只存“当前这一条”\n\nDataTable（内存快照）：一次性截屏。它把数据库返回的所有数据全部加载到内存里",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DataReader（流式读取）：只进不退的管道流。从数据库拉取数据时，读一条扔一条，内存里永远只存“当前这一条”\n\nDataTable（内存快照）：一次性截屏。它把数据库返回的所有数据全部加载到内存里",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
