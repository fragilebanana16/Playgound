      "updated": 1788948760072,
      "link": null,
      "locked": false,
      "text": "// 基础表（被很多表引用）\npublic class User\n{\n    public int Id { get; set; }\n    public string Name { get; set; }\n    \n    // ❌ 不推荐：不声明反向导航集合\n    // public List<Order> Orders { get; set; }\n    // public List<Review> Reviews { get; set; }\n    // public List<Message> Messages { get; set; }\n}\n\n// 子表1：指向 User\npublic class Order\n{\n    public int Id { get; set; }\n    public int UserId { get; set; }\n    public User User { get; set; }  // ✅ 单向导航：Order → User\n}\n\n// 子表2：指向 User\npublic class Review\n{\n    public int Id { get; set; }\n    public int UserId { get; set; }\n    public User User { get; set; }  // ✅ 单向导航：Review → User\n}\n\n// 子表3：指向 User\npublic class Message\n{\n    public int Id { get; set; }\n    public int UserId { get; set; }\n    public User User { get; set; }  // ✅ 单向导航：Message → User\n}",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// 基础表（被很多表引用）\npublic class User\n{\n    public int Id { get; set; }\n    public string Name { get; set; }\n    \n    // ❌ 不推荐：不声明反向导航集合\n    // public List<Order> Orders { get; set; }\n    // public List<Review> Reviews { get; set; }\n    // public List<Message> Messages { get; set; }\n}\n\n// 子表1：指向 User\npublic class Order\n{\n    public int Id { get; set; }\n    public int UserId { get; set; }\n    public User User { get; set; }  // ✅ 单向导航：Order → User\n}\n\n// 子表2：指向 User\npublic class Review\n{\n    public int Id { get; set; }\n    public int UserId { get; set; }\n    public User User { get; set; }  // ✅ 单向导航：Review → User\n}\n\n// 子表3：指向 User\npublic class Message\n{\n    public int Id { get; set; }\n    public int UserId { get; set; }\n    public User User { get; set; }  // ✅ 单向导航：Message → User\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "fbrJO6P3rZLx4hvjx6y-f",
      "type": "text",
      "x": 2990.418119269155,
      "y": 4365.805681403616,
      "width": 445,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFy",
      "roundness": null,
      "seed": 779352966,
      "version": 207,
      "versionNonce": 1517894342,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788948629829,
      "link": null,
      "locked": false,
      "text": "modelBuilder.Entity<Order>()\n    .HasOne(o => o.User)\n    .WithMany()                    // ← 无参数！User 没有 Orders 集合\n    .HasForeignKey(o => o.UserId);\n\nmodelBuilder.Entity<Review>()\n    .HasOne(r => r.User)\n    .WithMany()                    // ← 无参数！\n    .HasForeignKey(r => r.UserId);\n\nmodelBuilder.Entity<Message>()\n    .HasOne(m => m.User)\n    .WithMany()                    // ← 无参数！\n    .HasForeignKey(m => m.UserId);",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "modelBuilder.Entity<Order>()\n    .HasOne(o => o.User)\n    .WithMany()                    // ← 无参数！User 没有 Orders 集合\n    .HasForeignKey(o => o.UserId);\n\nmodelBuilder.Entity<Review>()\n    .HasOne(r => r.User)\n    .WithMany()                    // ← 无参数！\n    .HasForeignKey(r => r.UserId);\n\nmodelBuilder.Entity<Message>()\n    .HasOne(m => m.User)\n    .WithMany()                    // ← 无参数！\n    .HasForeignKey(m => m.UserId);",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
