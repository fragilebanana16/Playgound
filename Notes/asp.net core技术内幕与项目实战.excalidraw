      "text": "线程切换？",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "KHOtGQZjd3UpPkjuyLRw7",
      "originalText": "线程切换？",
