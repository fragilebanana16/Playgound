        }
      ],
      "updated": 1788839926039,
      "link": null,
      "locked": false,
      "text": "// 编译器会为此生成完整的状态机 struct\npublic async Task<string> GetDataAsync()\n{\n    return await _repository.GetDataAsync(); \n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// 编译器会为此生成完整的状态机 struct\npublic async Task<string> GetDataAsync()\n{\n    return await _repository.GetDataAsync(); \n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "YKF0okK367Ghj5W4mVjNg",
