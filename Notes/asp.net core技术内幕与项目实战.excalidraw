      "updated": 1788923954527,
      "link": null,
      "locked": false,
      "text": "// 场景 A：使用 IOptions（单例缓存）\npublic class ServiceA {\n    private readonly MySettings _settings;\n    public ServiceA(IOptions<MySettings> options) {\n        _settings = options.Value;\n    }\n}",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// 场景 A：使用 IOptions（单例缓存）\npublic class ServiceA {\n    private readonly MySettings _settings;\n    public ServiceA(IOptions<MySettings> options) {\n        _settings = options.Value;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
