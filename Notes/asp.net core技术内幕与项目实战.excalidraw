      "text": "struct <ProcessAsync>d__0 : IAsyncStateMachine\n{\n    public int <>1__state; // 状态记录：-1:初始, 0:停在 await1, 1:停在 await2\n    public AsyncTaskMethodBuilder <>t__builder;\n \n    private int <a>5__1;\n    private int <b>5__2;\n\n    public void MoveNext()\n    {\n        // 1. 回来时，通过 switch 一秒定位到上一次停下的位置\n        switch (this.<>1__state)\n        {\n            case 0: goto State0_Resume; // 从 await 1 恢复\n            case 1: goto State1_Resume; // 从 await 2 恢复\n        }\n\n        // ====== 段落 0：初始执行 ======\n        <a>5__1 = 1;\n        if (!Delay1.IsCompleted)\n        {\n            this.<>1__state = 0; // 记下状态 0\n            return;              // 挂起！释放线程\n        }\n\n    State0_Resume:\n        // ====== 段落 1：第一个 await 结束后的代码 ======\n        <b>5__2 = <a>5__1 + 2;\n        if (!Delay2.IsCompleted)\n        {\n            this.<>1__state = 1; // 记下状态 1\n            return;              // 挂起！释放线程\n        }\n\n    State1_Resume:\n        // ====== 段落 2：第二个 await 结束后的代码 ======\n        Console.WriteLine(<b>5__2);\n        this.<>t__builder.SetResult(); // 全部结束\n    }\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "RTXblWuHK1nlWXZjuUkAW",
      "originalText": "struct <ProcessAsync>d__0 : IAsyncStateMachine\n{\n    public int <>1__state; // 状态记录：-1:初始, 0:停在 await1, 1:停在 await2\n    public AsyncTaskMethodBuilder <>t__builder;\n \n    private int <a>5__1;\n    private int <b>5__2;\n\n    public void MoveNext()\n    {\n        // 1. 回来时，通过 switch 一秒定位到上一次停下的位置\n        switch (this.<>1__state)\n        {\n            case 0: goto State0_Resume; // 从 await 1 恢复\n            case 1: goto State1_Resume; // 从 await 2 恢复\n        }\n\n        // ====== 段落 0：初始执行 ======\n        <a>5__1 = 1;\n        if (!Delay1.IsCompleted)\n        {\n            this.<>1__state = 0; // 记下状态 0\n            return;              // 挂起！释放线程\n        }\n\n    State0_Resume:\n        // ====== 段落 1：第一个 await 结束后的代码 ======\n        <b>5__2 = <a>5__1 + 2;\n        if (!Delay2.IsCompleted)\n        {\n            this.<>1__state = 1; // 记下状态 1\n            return;              // 挂起！释放线程\n        }\n\n    State1_Resume:\n        // ====== 段落 2：第二个 await 结束后的代码 ======\n        Console.WriteLine(<b>5__2);\n        this.<>t__builder.SetResult(); // 全部结束\n    }\n}",
      "autoResize": true,
