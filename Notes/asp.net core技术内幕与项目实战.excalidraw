      "isDeleted": false,
      "boundElements": [
        {
          "id": "CiHYU4B3xHtsIF5VIKFXL",
          "type": "arrow"
        }
      ],
      "updated": 1788839932745,
      "link": null,
      "locked": false,
      "text": "// 没有 async/await，直接返回内部返回的 Task\npublic Task<string> GetDataAsync()\n{\n    return _repository.GetDataAsync(); \n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// 没有 async/await，直接返回内部返回的 Task\npublic Task<string> GetDataAsync()\n{\n    return _repository.GetDataAsync(); \n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
