      "text": "SSL / TLS （协议）",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SSL / TLS （协议）",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "U6PdakQdi9jZzOdKqT5vQ",
      "type": "text",
      "x": -787.985006637602,
      "y": -54.81278903257666,
      "width": 840.9998779296875,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "pXYc9PuyN2Y6lPo9LcGhY",
      "index": "b7dzzzzzzzzzzxt",
      "roundness": null,
      "seed": 599614451,
      "version": 493,
      "versionNonce": 1229172221,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787061654730,
      "link": null,
      "locked": false,
      "text": "SSL（Secure Sockets Layer）：旧一代的安全协议，由于存在安全漏洞，现在已经被淘汰。\nTLS（Transport Layer Security）：SSL 的升级换代版。现在大家口中说的“SSL”，99% 指的其实都是 TLS。",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SSL（Secure Sockets Layer）：旧一代的安全协议，由于存在安全漏洞，现在已经被淘汰。\nTLS（Transport Layer Security）：SSL 的升级换代版。现在大家口中说的“SSL”，99% 指的其实都是 TLS。",
      "autoResize": false,
      "lineHeight": 1.25
    },
