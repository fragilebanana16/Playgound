      "updated": 1786538518228,
      "link": null,
      "locked": false,
      "text": "    typedef union epoll_data {\n        void        *ptr;\n        int          fd;\n        uint32_t     u32;\n        uint64_t     u64;\n    } epoll_data_t;\n    \n    struct epoll_event {\n        uint32_t     events;    // 事件类型\n        epoll_data_t data;      // 用户自定义数据\n    };",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "VdAJJrPCikN5oTuysyVaj",
      "originalText": "    typedef union epoll_data {\n        void        *ptr;\n        int          fd;\n        uint32_t     u32;\n        uint64_t     u64;\n    } epoll_data_t;\n    \n    struct epoll_event {\n        uint32_t     events;    // 事件类型\n        epoll_data_t data;      // 用户自定义数据\n    };",
      "autoResize": true,
      "lineHeight": 1.25
    },
