    {
      "id": "8HRz81UiRK3S4YwpZzJfG",
      "type": "text",
      "x": -769.4848845672896,
      "y": 276.1898768151209,
      "width": 617,
      "height": 261.16402116402116,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
