      "boundElements": null,
      "updated": 1786538598186,
      "link": null,
      "locked": false,
      "text": "performance.mark() 是 User Timing API 的核心方法，它的主要作用是：在浏览器的性\n能时间线上打一个“自定义时间戳”（标记点）",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "performance.mark() 是 User Timing API 的核心方法，它的主要作用是：在浏览器的性能时间线上打一个“自定义时间戳”（标记点）",
      "autoResize": false,
      "lineHeight": 1.25
    },
