      "link": null,
      "locked": false,
      "text": "文件没变：服务器返回 304 Not Modified（响应体为空，极省流量），告知浏览器直接用\n本地缓存。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "文件没变：服务器返回 304 Not Modified（响应体为空，极省流量），告知浏览器直接用本地缓存。",
      "autoResize": false,
      "lineHeight": 1.25
    },
