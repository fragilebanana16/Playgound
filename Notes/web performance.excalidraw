      "seed": 1279850141,
      "version": 1062,
      "versionNonce": 710762429,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787061654730,
      "link": null,
      "locked": false,
      "text": "[ 网站服务器 ]                                        [ 浏览器 ]\n      │                                                       │\n  1. 发送【服务器证书】 ─────────────> │\n                                                               │ 2. 拆解证书：拿到明文信息与【CA 签名】\n                                                               │\n                                                               │ 3. 用本地内置的【CA 公钥】解密【CA 签名】\n                                                               │    得到原始哈希值 A\n                                                               │\n                                                               │ 4. 用相同算法计算证书明文的哈希值 B\n                                                               │\n                                                               │ 5. 比对哈希值：\n                                                               │    - A == B：明文未被篡改！\n                                                               │    - 检查域名、有效期、撤销状态 (OCSP)\n                                                               │\n                                                               │ 6. 验证通过！提取证书中的【网站公钥】\n                                                               │    安全建立加密连接",
      "fontSize": 13.058201058201064,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[ 网站服务器 ]                                        [ 浏览器 ]\n      │                                                       │\n  1. 发送【服务器证书】 ─────────────> │\n                                                               │ 2. 拆解证书：拿到明文信息与【CA 签名】\n                                                               │\n                                                               │ 3. 用本地内置的【CA 公钥】解密【CA 签名】\n                                                               │    得到原始哈希值 A\n                                                               │\n                                                               │ 4. 用相同算法计算证书明文的哈希值 B\n                                                               │\n                                                               │ 5. 比对哈希值：\n                                                               │    - A == B：明文未被篡改！\n                                                               │    - 检查域名、有效期、撤销状态 (OCSP)\n                                                               │\n                                                               │ 6. 验证通过！提取证书中的【网站公钥】\n                                                               │    安全建立加密连接",
      "autoResize": true,
      "lineHeight": 1.25
    },
