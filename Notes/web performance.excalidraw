    {
      "id": "NGleejwCtNZalKgx7sszr",
      "type": "text",
      "x": 498.7753425031924,
      "y": 443.036712333759,
      "width": 460,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
