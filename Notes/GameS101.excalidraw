      "locked": false,
      "fontSize": 28,
      "fontFamily": 6,
      "text": "缓冲区类型",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ZNGz3Tdyan-qCcVcHNmTJ",
      "originalText": "缓冲区类型",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "type": "text",
      "version": 298,
      "versionNonce": 1009565410,
      "index": "bGl",
      "isDeleted": false,
      "id": "x-I4V6i4rZbSa9RuaqcfC",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 10808.567282921445,
      "y": 1684.4155497278944,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "width": 1217.0000000000005,
      "height": 1475,
      "seed": 1639483362,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1792033560400,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 8,
      "text": "// ============================================================================\n// 1. VBO / IBO (顶点/索引缓冲区)\n// 适用场景：存储网格几何体（坐标、法线、UV、顶点索引），定义模型长什么样。\n// ============================================================================\nGLuint vbo, ibo;\nglGenBuffers(1, &vbo);\nglBindBuffer(GL_ARRAY_BUFFER, vbo);\nglBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW); // 顶点坐标\n\nglGenBuffers(1, &ibo);\nglBindBuffer(GL_ELEMENT_ARRAY_BUFFER, ibo);\nglBufferData(GL_ELEMENT_ARRAY_BUFFER, sizeof(indices), indices, GL_STATIC_DRAW); // 三角形序号\n\n// ============================================================================\n// 2. UBO (Uniform Buffer - 统一常量缓冲区)\n// 适用场景：跨着色器共享的只读全局变量（相机矩阵 View/Proj、灯光参数等）。\n// 特性：只读、极速、容量小（限制 ≤ 64 KB）。\n// ============================================================================\nGLuint ubo;\nglGenBuffers(1, &ubo);\nglBindBuffer(GL_UNIFORM_BUFFER, ubo);\nglBufferData(GL_UNIFORM_BUFFER, sizeof(CameraData), &camData, GL_DYNAMIC_DRAW);\nglBindBufferBase(GL_UNIFORM_BUFFER, 0, ubo); // 挂载到 Shader 的 binding = 0\n\n// ============================================================================\n// 3. SSBO (Shader Storage Buffer - 着色器存储缓冲区)\n// 适用场景：大批量动态数据（30,000 个物体的世界矩阵、粒子系统、GPU Compute 计算）。\n// 特性：大容量（几百 MB 到 GB）、Shader 可读可写、支持原子操作。\n// ============================================================================\nGLuint ssbo;\nglGenBuffers(1, &ssbo);\nglBindBuffer(GL_SHADER_STORAGE_BUFFER, ssbo);\nglBufferData(GL_SHADER_STORAGE_BUFFER, 30000 * sizeof(mat4), initialMatrices, GL_DYNAMIC_DRAW);\nglBindBufferBase(GL_SHADER_STORAGE_BUFFER, 1, ssbo); // 挂载到 Shader 的 binding = 1\n\n// ============================================================================\n// 4. Indirect Buffer (间接绘制缓冲区)\n// 适用场景：海量绘制命令（30,000 条 Draw Call 结构体），配合 Compute Shader 实现 GPU-Driven。\n// 特性：CPU 只需 1 次 API 发射，由 GPU Command Processor 自动读取参数并绘制。\n// ============================================================================\nGLuint indirectBuffer;\nglGenBuffers(1, &indirectBuffer);\nglBindBuffer(GL_DRAW_INDIRECT_BUFFER, indirectBuffer);\nglBufferData(GL_DRAW_INDIRECT_BUFFER, 30000 * sizeof(DrawElementsIndirectCommand), NULL, GL_DYNAMIC_DRAW);\n\n// ============================================================================\n// 5. FBO / Depth Buffer (帧缓冲区 / 离屏渲染目标)\n// 适用场景：离屏渲染（阴影贴图 ShadowMap、后处理 Bloom/Blur、延迟渲染 G-Buffer）。\n// 特性：不画到屏幕，而是把颜色/深度渲染输出到指定的 Texture 或 Renderbuffer。\n// ============================================================================\nGLuint fbo, depthTexture;\nglGenFramebuffers(1, &fbo);\nglBindFramebuffer(GL_FRAMEBUFFER, fbo);\n\n// 挂载用于离屏接收深度值的 Texture\nglGenTextures(1, &depthTexture);\nglBindTexture(GL_TEXTURE_2D, depthTexture);\nglTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_COMPONENT, 1024, 1024, 0, GL_DEPTH_COMPONENT, GL_FLOAT, NULL);\nglFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, depthTexture, 0);",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// ============================================================================\n// 1. VBO / IBO (顶点/索引缓冲区)\n// 适用场景：存储网格几何体（坐标、法线、UV、顶点索引），定义模型长什么样。\n// ============================================================================\nGLuint vbo, ibo;\nglGenBuffers(1, &vbo);\nglBindBuffer(GL_ARRAY_BUFFER, vbo);\nglBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW); // 顶点坐标\n\nglGenBuffers(1, &ibo);\nglBindBuffer(GL_ELEMENT_ARRAY_BUFFER, ibo);\nglBufferData(GL_ELEMENT_ARRAY_BUFFER, sizeof(indices), indices, GL_STATIC_DRAW); // 三角形序号\n\n// ============================================================================\n// 2. UBO (Uniform Buffer - 统一常量缓冲区)\n// 适用场景：跨着色器共享的只读全局变量（相机矩阵 View/Proj、灯光参数等）。\n// 特性：只读、极速、容量小（限制 ≤ 64 KB）。\n// ============================================================================\nGLuint ubo;\nglGenBuffers(1, &ubo);\nglBindBuffer(GL_UNIFORM_BUFFER, ubo);\nglBufferData(GL_UNIFORM_BUFFER, sizeof(CameraData), &camData, GL_DYNAMIC_DRAW);\nglBindBufferBase(GL_UNIFORM_BUFFER, 0, ubo); // 挂载到 Shader 的 binding = 0\n\n// ============================================================================\n// 3. SSBO (Shader Storage Buffer - 着色器存储缓冲区)\n// 适用场景：大批量动态数据（30,000 个物体的世界矩阵、粒子系统、GPU Compute 计算）。\n// 特性：大容量（几百 MB 到 GB）、Shader 可读可写、支持原子操作。\n// ============================================================================\nGLuint ssbo;\nglGenBuffers(1, &ssbo);\nglBindBuffer(GL_SHADER_STORAGE_BUFFER, ssbo);\nglBufferData(GL_SHADER_STORAGE_BUFFER, 30000 * sizeof(mat4), initialMatrices, GL_DYNAMIC_DRAW);\nglBindBufferBase(GL_SHADER_STORAGE_BUFFER, 1, ssbo); // 挂载到 Shader 的 binding = 1\n\n// ============================================================================\n// 4. Indirect Buffer (间接绘制缓冲区)\n// 适用场景：海量绘制命令（30,000 条 Draw Call 结构体），配合 Compute Shader 实现 GPU-Driven。\n// 特性：CPU 只需 1 次 API 发射，由 GPU Command Processor 自动读取参数并绘制。\n// ============================================================================\nGLuint indirectBuffer;\nglGenBuffers(1, &indirectBuffer);\nglBindBuffer(GL_DRAW_INDIRECT_BUFFER, indirectBuffer);\nglBufferData(GL_DRAW_INDIRECT_BUFFER, 30000 * sizeof(DrawElementsIndirectCommand), NULL, GL_DYNAMIC_DRAW);\n\n// ============================================================================\n// 5. FBO / Depth Buffer (帧缓冲区 / 离屏渲染目标)\n// 适用场景：离屏渲染（阴影贴图 ShadowMap、后处理 Bloom/Blur、延迟渲染 G-Buffer）。\n// 特性：不画到屏幕，而是把颜色/深度渲染输出到指定的 Texture 或 Renderbuffer。\n// ============================================================================\nGLuint fbo, depthTexture;\nglGenFramebuffers(1, &fbo);\nglBindFramebuffer(GL_FRAMEBUFFER, fbo);\n\n// 挂载用于离屏接收深度值的 Texture\nglGenTextures(1, &depthTexture);\nglBindTexture(GL_TEXTURE_2D, depthTexture);\nglTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_COMPONENT, 1024, 1024, 0, GL_DEPTH_COMPONENT, GL_FLOAT, NULL);\nglFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, depthTexture, 0);",
      "autoResize": false,
      "lineHeight": 1.25
    },
