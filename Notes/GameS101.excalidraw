      "link": null,
      "locked": false,
      "subtype": "math",
      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{bmatrix} x_{\\text{screen}} \\\\[6pt] y_{\\text{screen}} \\\\[6pt] z_{\\text{depth}} \\\\[6pt] 1 \\end{bmatrix} = \\begin{bmatrix} \\dfrac{W}{2} & 0 & 0 & \\dfrac{W}{2} \\\\[12pt] 0 & \\dfrac{H}{2} & 0 & \\dfrac{H}{2} \\\\[12pt] 0 & 0 & \\dfrac{1}{2} & \\dfrac{1}{2} \\\\[12pt] 0 & 0 & 0 & 1 \\end{bmatrix} \\begin{bmatrix} x_{\\text{ndc}} \\\\[6pt] y_{\\text{ndc}} \\\\[6pt] z_{\\text{ndc}} \\\\[6pt] 1 \\end{bmatrix}"
      },
      "fontSize": 20,
      "fontFamily": 2,
      "text": "\\begin{bmatrix}\nx_{\\text{screen}} \\\\[6pt]\ny_{\\text{screen}} \\\\[6pt]\nz_{\\text{depth}} \\\\[6pt]\n1\n\\end{bmatrix}\n=\n\\begin{bmatrix}\n\\dfrac{W}{2} & 0 & 0 & \\dfrac{W}{2} \\\\[12pt]\n0 & \\dfrac{H}{2} & 0 & \\dfrac{H}{2} \\\\[12pt]\n0 & 0 & \\dfrac{1}{2} & \\dfrac{1}{2} \\\\[12pt]\n0 & 0 & 0 & 1\n\\end{bmatrix}\n\\begin{bmatrix}\nx_{\\text{ndc}} \\\\[6pt]\ny_{\\text{ndc}} \\\\[6pt]\nz_{\\text{ndc}} \\\\[6pt]\n1\n\\end{bmatrix}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{bmatrix}\nx_{\\text{screen}} \\\\[6pt]\ny_{\\text{screen}} \\\\[6pt]\nz_{\\text{depth}} \\\\[6pt]\n1\n\\end{bmatrix}\n=\n\\begin{bmatrix}\n\\dfrac{W}{2} & 0 & 0 & \\dfrac{W}{2} \\\\[12pt]\n0 & \\dfrac{H}{2} & 0 & \\dfrac{H}{2} \\\\[12pt]\n0 & 0 & \\dfrac{1}{2} & \\dfrac{1}{2} \\\\[12pt]\n0 & 0 & 0 & 1\n\\end{bmatrix}\n\\begin{bmatrix}\nx_{\\text{ndc}} \\\\[6pt]\ny_{\\text{ndc}} \\\\[6pt]\nz_{\\text{ndc}} \\\\[6pt]\n1\n\\end{bmatrix}",
      "autoResize": true,
      "lineHeight": 1.15
    },
