        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "P = \\begin{bmatrix} \\dfrac{2n}{r-l} & 0 & \\dfrac{r+l}{r-l} & 0 \\\\[12pt] 0 & \\dfrac{2n}{t-b} & \\dfrac{t+b}{t-b} & 0 \\\\[12pt] 0 & 0 & -\\dfrac{f+n}{f-n} & -\\dfrac{2nf}{f-n} \\\\[12pt] 0 & 0 & -1 & 0 \\end{bmatrix}"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "text": "P =\n\\begin{bmatrix}\n\\dfrac{2n}{r-l} & 0 & \\dfrac{r+l}{r-l} & 0 \\\\[12pt]\n0 & \\dfrac{2n}{t-b} & \\dfrac{t+b}{t-b} & 0 \\\\[12pt]\n0 & 0 & -\\dfrac{f+n}{f-n} & -\\dfrac{2nf}{f-n} \\\\[12pt]\n0 & 0 & -1 & 0\n\\end{bmatrix}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P =\n\\begin{bmatrix}\n\\dfrac{2n}{r-l} & 0 & \\dfrac{r+l}{r-l} & 0 \\\\[12pt]\n0 & \\dfrac{2n}{t-b} & \\dfrac{t+b}{t-b} & 0 \\\\[12pt]\n0 & 0 & -\\dfrac{f+n}{f-n} & -\\dfrac{2nf}{f-n} \\\\[12pt]\n0 & 0 & -1 & 0\n\\end{bmatrix}",
