    {
      "id": "9QHLL_M-kSlPCsSBDNuVG",
      "type": "text",
      "x": 5541.299685058653,
      "y": 2071.8949657141384,
      "width": 595,
      "height": 626.4000000000001,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9U",
      "roundness": null,
      "seed": 2090529933,
      "version": 308,
      "versionNonce": 139095725,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790698088386,
      "link": null,
      "locked": false,
      "text": "GLuint vao, vbo;\n\nglGenVertexArrays(1, &vao);\nglGenBuffers(1, &vbo);\n\nglBindVertexArray(vao);\n\nglBindBuffer(GL_ARRAY_BUFFER, vbo);\n\nglBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW);\n\nglVertexAttribPointer(\n    0,                           //  插槽号\n    3,                           // 分量数(aPos)\n    GL_FLOAT,           //  分量类型\n    GL_FALSE,           // 是否归一化\n    3 * sizeof(float),  //  步长\n    (void*)0                // 偏移\n);\n\nglEnableVertexAttribArray(0);\n\nglBindVertexArray(0);\n\nglUseProgram(program);\n\nglBindVertexArray(vao);\n\nglDrawArrays(GL_TRIANGLES, 0, 3);",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GLuint vao, vbo;\n\nglGenVertexArrays(1, &vao);\nglGenBuffers(1, &vbo);\n\nglBindVertexArray(vao);\n\nglBindBuffer(GL_ARRAY_BUFFER, vbo);\n\nglBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW);\n\nglVertexAttribPointer(\n    0,                           //  插槽号\n    3,                           // 分量数(aPos)\n    GL_FLOAT,           //  分量类型\n    GL_FALSE,           // 是否归一化\n    3 * sizeof(float),  //  步长\n    (void*)0                // 偏移\n);\n\nglEnableVertexAttribArray(0);\n\nglBindVertexArray(0);\n\nglUseProgram(program);\n\nglBindVertexArray(vao);\n\nglDrawArrays(GL_TRIANGLES, 0, 3);",
      "autoResize": true,
      "lineHeight": 1.35
    },
