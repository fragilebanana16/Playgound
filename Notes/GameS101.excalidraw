      "fontFamily": 8,
      "text": "layout (location = 0) in vec4 position;           // 逐顶点\nlayout (location = 1) in vec4 instance_color;     // 逐实例\nlayout (location = 2) in vec4 instance_position;  // 逐实例\n\nvoid main() {\n    gl_Position = mvp * (position + instance_position);\n    fragment.color = instance_color;\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "layout (location = 0) in vec4 position;           // 逐顶点\nlayout (location = 1) in vec4 instance_color;     // 逐实例\nlayout (location = 2) in vec4 instance_position;  // 逐实例\n\nvoid main() {\n    gl_Position = mvp * (position + instance_position);\n    fragment.color = instance_color;\n}",
