    {
      "subtype": "math",
      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{aligned} z = -n &\\;\\Longrightarrow\\; z_{\\text{ndc}} = -1 \\\\ z = -f &\\;\\Longrightarrow\\; z_{\\text{ndc}} = +1 \\end{aligned}"
      },
      "id": "WVU1-bQeatPkfaU3PV1vb",
