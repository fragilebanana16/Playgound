    {
      "id": "azec0VojWnkRZY0Xhe0w-",
      "type": "text",
      "x": 3760.029791579695,
      "y": 6009.956192500419,
      "width": 290,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#fab005",
