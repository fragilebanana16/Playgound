      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1791553523482,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 8,
      "text": "完全不需要调用 glMemoryBarrier的情况（CPU 写，GPU 读）",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "完全不需要调用 glMemoryBarrier的情况（CPU 写，GPU 读）",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
