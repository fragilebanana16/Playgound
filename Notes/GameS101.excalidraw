      "updated": 1793799442106,
      "link": null,
      "locked": false,
      "subtype": "math",
      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{aligned} L_o(x,\\omega_o) &: \\text{点 } x \\text{ 沿方向 } \\omega_o \\text{  的出射辐射亮度（相机看到的）} \\\\ L_e(x,\\omega_o) &: \\text{该点沿 } \\omega_o \\text{ 的自发光亮度（普通表面为 0）} \\\\ f_r(x,\\omega_i,\\omega_o) &: \\text{BRDF，表面把 } \\omega_i \\text{ 方向入射光反射到 }  \\omega_o \\text{ 的比例} \\\\ L_i(x,\\omega_i) &: \\text{从方向 } \\omega_i \\text{ 到达点 } x \\text{ 的入射辐射亮度} \\\\ \\cos\\theta_i &: \\text{入射方向与法线夹角的余弦（投影因子）} \\\\ \\Omega &: \\text{法线所在半球（} 2\\pi \\text{ sr）} \\\\ d\\omega_i &: \\text{入射立体角微元} \\end{aligned}"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "text": "\\begin{aligned}\nL_o(x,\\omega_o) &: \\text{点 } x \\text{ 沿方向 } \\omega_o \\text{ \n的出射辐射亮度（相机看到的）} \\\\\nL_e(x,\\omega_o) &: \\text{该点沿 } \\omega_o \\text{ 的自发光亮度（普通表面为 0）} \\\\\nf_r(x,\\omega_i,\\omega_o) &: \\text{BRDF，表面把 } \\omega_i \\text{ 方向入射光反射到 } \n\\omega_o \\text{ 的比例} \\\\\nL_i(x,\\omega_i) &: \\text{从方向 } \\omega_i \\text{ 到达点 } x \\text{ 的入射辐射亮度} \\\\\n\\cos\\theta_i &: \\text{入射方向与法线夹角的余弦（投影因子）} \\\\\n\\Omega &: \\text{法线所在半球（} 2\\pi \\text{ sr）} \\\\\nd\\omega_i &: \\text{入射立体角微元}\n\\end{aligned}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{aligned}\nL_o(x,\\omega_o) &: \\text{点 } x \\text{ 沿方向 } \\omega_o \\text{ 的出射辐射亮度（相机看到的）} \\\\\nL_e(x,\\omega_o) &: \\text{该点沿 } \\omega_o \\text{ 的自发光亮度（普通表面为 0）} \\\\\nf_r(x,\\omega_i,\\omega_o) &: \\text{BRDF，表面把 } \\omega_i \\text{ 方向入射光反射到 } \\omega_o \\text{ 的比例} \\\\\nL_i(x,\\omega_i) &: \\text{从方向 } \\omega_i \\text{ 到达点 } x \\text{ 的入射辐射亮度} \\\\\n\\cos\\theta_i &: \\text{入射方向与法线夹角的余弦（投影因子）} \\\\\n\\Omega &: \\text{法线所在半球（} 2\\pi \\text{ sr）} \\\\\nd\\omega_i &: \\text{入射立体角微元}\n\\end{aligned}",
      "autoResize": false,
      "lineHeight": 1.15
    },
