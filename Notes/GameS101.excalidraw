      "fontSize": 16,
      "fontFamily": 8,
      "text": "float fDotProduct = max(0.0, dot(vNormal, vLightDir));\nvec3 vDiffuseColor = vDiffuseMaterial * vDiffuseLight * fDotProduct;",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "float fDotProduct = max(0.0, dot(vNormal, vLightDir));\nvec3 vDiffuseColor = vDiffuseMaterial * vDiffuseLight * fDotProduct;",
      "autoResize": true,
      "lineHeight": 1.25
    },
