      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{aligned}\nt &= n \\tan\\!\\left(\\frac{\\text{fov}}{2}\\right)\n&\\Longrightarrow\\quad \\frac{n}{t} &= \\frac{1}{\\tan(\\text{fov}/2)} = \\cot\\!\\left(\\frac{\\text{fov}}{2}\\right) \\\\\nr &= t \\cdot \\text{aspect}\n&\\Longrightarrow\\quad \\frac{n}{r} &= \\frac{1}{\\text{aspect}\\cdot\\tan(\\text{fov}/2)}\n\\end{aligned}",
      "autoResize": false,
      "lineHeight": 1.15
    },
    {
      "subtype": "math",
      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "P = \\begin{bmatrix} \\dfrac{1}{\\text{aspect}\\cdot\\tan(\\text{fov}/2)} & 0 & 0 & 0 \\\\[12pt] 0 & \\dfrac{1}{\\tan(\\text{fov}/2)} & 0 & 0 \\\\[12pt] 0 & 0 & -\\dfrac{f+n}{f-n} & -\\dfrac{2nf}{f-n} \\\\[12pt] 0 & 0 & -1 & 0 \\end{bmatrix}"
      },
