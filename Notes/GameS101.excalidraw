      "updated": 1790685297181,
      "link": null,
      "locked": false,
      "text": "#version 410 core\n\nlayout (triangles, equal_spacing, cw) in;\n\nvoid main(void)\n{\n    gl_Position = (gl_TessCoord.x * gl_in[0].gl_Position) +\n                  (gl_TessCoord.y * gl_in[1].gl_Position) +\n                  (gl_TessCoord.z * gl_in[2].gl_Position);\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#version 410 core\n\nlayout (triangles, equal_spacing, cw) in;\n\nvoid main(void)\n{\n    gl_Position = (gl_TessCoord.x * gl_in[0].gl_Position) +\n                  (gl_TessCoord.y * gl_in[1].gl_Position) +\n                  (gl_TessCoord.z * gl_in[2].gl_Position);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
