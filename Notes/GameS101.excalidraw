      "id": "RvIOmTI95Fi--01eD0DDv",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 9024.754002187938,
      "y": 841.6399122534515,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "width": 348,
