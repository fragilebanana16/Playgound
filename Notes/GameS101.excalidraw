    {
      "type": "text",
      "version": 210,
      "versionNonce": 75453373,
      "index": "a1",
      "isDeleted": false,
      "id": "-CIcliPyI9p3VpPlpF7w_",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 7080.786487068883,
      "y": 2155.049118459563,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "width": 803,
      "height": 460,
      "seed": 752245245,
      "groupIds": [],
