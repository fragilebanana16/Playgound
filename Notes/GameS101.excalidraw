      "subtype": "math",
      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{bmatrix} T_x & B_x \\\\ T_y & B_y \\\\ T_z & B_z \\end{bmatrix} = \\frac{1}{\\Delta U_1 \\Delta V_2 - \\Delta U_2 \\Delta V_1} \\begin{bmatrix} \\Delta V_2 & -\\Delta U_2 \\\\ -\\Delta V_1 & \\Delta U_1 \\end{bmatrix} \\begin{bmatrix} E_{1x} & E_{2x} \\\\ E_{1y} & E_{2y} \\\\ E_{1z} & E_{2z} \\end{bmatrix}"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "text": "\\begin{bmatrix}\nT_x & B_x \\\\\nT_y & B_y \\\\\nT_z & B_z\n\\end{bmatrix}\n=\n\\frac{1}{\\Delta U_1 \\Delta V_2 - \\Delta U_2 \\Delta V_1}\n\\begin{bmatrix}\n\\Delta V_2 & -\\Delta U_2 \\\\\n-\\Delta V_1 & \\Delta U_1\n\\end{bmatrix}\n\\begin{bmatrix}\nE_{1x} & E_{2x} \\\\\nE_{1y} & E_{2y} \\\\\nE_{1z} & E_{2z}\n\\end{bmatrix}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{bmatrix}\nT_x & B_x \\\\\nT_y & B_y \\\\\nT_z & B_z\n\\end{bmatrix}\n=\n\\frac{1}{\\Delta U_1 \\Delta V_2 - \\Delta U_2 \\Delta V_1}\n\\begin{bmatrix}\n\\Delta V_2 & -\\Delta U_2 \\\\\n-\\Delta V_1 & \\Delta U_1\n\\end{bmatrix}\n\\begin{bmatrix}\nE_{1x} & E_{2x} \\\\\nE_{1y} & E_{2y} \\\\\nE_{1z} & E_{2z}\n\\end{bmatrix}",
      "autoResize": true,
      "lineHeight": 1.15
    },
