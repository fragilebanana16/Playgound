      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\hat{I} = \\frac{1}{N}\\sum_{k=1}^{N} \\frac{g(\\omega_k)}{p(\\omega_k)}"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "text": "\\hat{I} = \\frac{1}{N}\\sum_{k=1}^{N} \\frac{g(\\omega_k)}{p(\\omega_k)}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\hat{I} = \\frac{1}{N}\\sum_{k=1}^{N} \\frac{g(\\omega_k)}{p(\\omega_k)}",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "type": "text",
      "version": 77,
      "versionNonce": 134306145,
      "index": "bMp",
      "isDeleted": false,
      "id": "Kpa-BVOuURa-YIDYlOxw0",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 4999.317848450278,
      "y": 5107.950436584065,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffec99",
      "width": 418.671875,
      "height": 166.890625,
      "seed": 1265442127,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1793799391937,
      "link": null,
      "locked": false,
      "subtype": "math",
      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{aligned} \\hat{I} &= \\text{对真积分 } I \\text{ 的估计值（带帽子表示“估计”）} \\\\ N &= \\text{采样次数（路径条数）} \\\\ \\omega_k &= \\text{第 } k \\text{ 次按概率密度 } p(\\omega) \\text{ 随机采到的方向} \\\\ g(\\omega_k) &= \\text{被积函数在该方向的值} \\\\ p(\\omega_k) &= \\text{采样该方向的概率密度} \\\\ \\frac{g(\\omega_k)}{p(\\omega_k)} &= \\text{单个样本的加权贡献} \\end{aligned}"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "text": "\\begin{aligned}\n\\hat{I} &= \\text{对真积分 } I \\text{ 的估计值（带帽子表示“估计”）} \\\\\nN &= \\text{采样次数（路径条数）} \\\\\n\\omega_k &= \\text{第 } k \\text{ 次按概率密度 } p(\\omega) \\text{ 随机采到的方向} \\\\\ng(\\omega_k) &= \\text{被积函数在该方向的值} \\\\\np(\\omega_k) &= \\text{采样该方向的概率密度} \\\\\n\\frac{g(\\omega_k)}{p(\\omega_k)} &= \\text{单个样本的加权贡献}\n\\end{aligned}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{aligned}\n\\hat{I} &= \\text{对真积分 } I \\text{ 的估计值（带帽子表示“估计”）} \\\\\nN &= \\text{采样次数（路径条数）} \\\\\n\\omega_k &= \\text{第 } k \\text{ 次按概率密度 } p(\\omega) \\text{ 随机采到的方向} \\\\\ng(\\omega_k) &= \\text{被积函数在该方向的值} \\\\\np(\\omega_k) &= \\text{采样该方向的概率密度} \\\\\n\\frac{g(\\omega_k)}{p(\\omega_k)} &= \\text{单个样本的加权贡献}\n\\end{aligned}",
      "autoResize": true,
      "lineHeight": 1.15
    },
