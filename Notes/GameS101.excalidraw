      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "M_{\\text{viewport}} = \\begin{bmatrix} \\dfrac{W}{2} & 0 & 0 & \\dfrac{W}{2} \\\\[10pt] 0 & \\dfrac{H}{2} & 0 & \\dfrac{H}{2} \\\\[10pt] 0 & 0 & \\dfrac{1}{2} & \\dfrac{1}{2} \\\\[10pt] 0 & 0 & 0 & 1 \\end{bmatrix}"
      },
      "fontSize": 20,
      "fontFamily": 2,
      "text": "M_{\\text{viewport}} =\n\\begin{bmatrix}\n\\dfrac{W}{2} & 0 & 0 & \\dfrac{W}{2} \\\\[10pt]\n0 & \\dfrac{H}{2} & 0 & \\dfrac{H}{2} \\\\[10pt]\n0 & 0 & \\dfrac{1}{2} & \\dfrac{1}{2} \\\\[10pt]\n0 & 0 & 0 & 1\n\\end{bmatrix}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "M_{\\text{viewport}} =\n\\begin{bmatrix}\n\\dfrac{W}{2} & 0 & 0 & \\dfrac{W}{2} \\\\[10pt]\n0 & \\dfrac{H}{2} & 0 & \\dfrac{H}{2} \\\\[10pt]\n0 & 0 & \\dfrac{1}{2} & \\dfrac{1}{2} \\\\[10pt]\n0 & 0 & 0 & 1\n\\end{bmatrix}",
      "autoResize": true,
      "lineHeight": 1.15
    },
