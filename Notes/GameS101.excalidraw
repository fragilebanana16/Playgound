    {
      "type": "text",
      "version": 54,
      "versionNonce": 1641738104,
      "index": "bDo",
      "isDeleted": false,
      "id": "4v6wt3ERbl3BUwfjtMrJI",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 9028.780907192013,
      "y": 2101.511108704966,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 480,
      "height": 75,
      "seed": 1058774904,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1791794818306,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 8,
      "text": "传统方式，顶点和片段必须绑在一起链接\n每个着色器单独链接成独立程序\n运行时用程序管线对象按阶段绑定，动态拼出完整管线",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "传统方式，顶点和片段必须绑在一起链接\n每个着色器单独链接成独立程序\n运行时用程序管线对象按阶段绑定，动态拼出完整管线",
      "autoResize": true,
      "lineHeight": 1.25
    },
