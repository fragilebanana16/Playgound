        }
      ],
      "updated": 1790137240460,
      "link": null,
      "locked": false,
      "text": "\\begin{aligned}\nx_{\\text{clip}} &= \\frac{2}{r-l}\\,x + 0\\cdot y + 0\\cdot z - \\frac{r+l}{r-l}\\cdot 1 \\\\[6pt]\ny_{\\text{clip}} &= 0\\cdot x + \\frac{2}{t-b}\\,y + 0\\cdot z - \\frac{t+b}{t-b}\\cdot 1 \\\\[6pt]\nz_{\\text{clip}} &= 0\\cdot x + 0\\cdot y - \\frac{2}{f-n}\\,z - \\frac{f+n}{f-n}\\cdot 1 \\\\[6pt]\nw_{\\text{clip}} &= 0\\cdot x + 0\\cdot y + 0\\cdot z + 1\\cdot 1\n\\end{aligned}",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{aligned}\nx_{\\text{clip}} &= \\frac{2}{r-l}\\,x + 0\\cdot y + 0\\cdot z - \\frac{r+l}{r-l}\\cdot 1 \\\\[6pt]\ny_{\\text{clip}} &= 0\\cdot x + \\frac{2}{t-b}\\,y + 0\\cdot z - \\frac{t+b}{t-b}\\cdot 1 \\\\[6pt]\nz_{\\text{clip}} &= 0\\cdot x + 0\\cdot y - \\frac{2}{f-n}\\,z - \\frac{f+n}{f-n}\\cdot 1 \\\\[6pt]\nw_{\\text{clip}} &= 0\\cdot x + 0\\cdot y + 0\\cdot z + 1\\cdot 1\n\\end{aligned}",
