      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{aligned} &\\text{fov} &&: \\text{垂直视野角} \\\\ &\\text{aspect} = \\frac{w}{h} &&:  \\text{宽高比} \\\\ &n > 0 &&: \\text{近裁剪面距离} \\\\ &f > n &&: \\text{远裁剪面距离} \\end{aligned}"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "text": "\\begin{aligned}\n&\\text{fov} &&: \\text{垂直视野角} \\\\\n&\\text{aspect} = \\frac{w}{h} &&: \n\\text{宽高比} \\\\\n&n > 0 &&: \\text{近裁剪面距离} \\\\\n&f > n &&: \\text{远裁剪面距离}\n\\end{aligned}",
