      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{pmatrix} x'\\\\y'\\\\z'\\\\1 \\end{pmatrix} = \\begin{pmatrix} 1&0&0&0\\\\ 0&\\cos\\theta&-\\sin\\theta&0\\\\ 0&\\sin\\theta&\\cos\\theta&0\\\\ 0&0&0&1 \\end{pmatrix} \\begin{pmatrix} x\\\\y\\\\z\\\\1 \\end{pmatrix} = \\begin{pmatrix} x\\\\ y\\cos\\theta-z\\sin\\theta\\\\ y\\sin\\theta+z\\cos\\theta\\\\ 1 \\end{pmatrix}"
      },
      "fontSize": 20,
      "fontFamily": 2,
      "text": "\\begin{pmatrix}\nx'\\\\y'\\\\z'\\\\1\n\\end{pmatrix}\n=\n\\begin{pmatrix}\n1&0&0&0\\\\\n0&\\cos\\theta&-\\sin\\theta&0\\\\\n0&\\sin\\theta&\\cos\\theta&0\\\\\n0&0&0&1\n\\end{pmatrix}\n\\begin{pmatrix}\nx\\\\y\\\\z\\\\1\n\\end{pmatrix}\n=\n\\begin{pmatrix}\nx\\\\\ny\\cos\\theta-z\\sin\\theta\\\\\ny\\sin\\theta+z\\cos\\theta\\\\\n1\n\\end{pmatrix}",
