        "ariaLabel": "\\begin{aligned} z = -n &\\;\\Longrightarrow\\; z_{\\text{ndc}} = -1 \\\\ z = -f &\\;\\Longrightarrow\\; z_{\\text{ndc}} = +1 \\end{aligned}"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "text": "\\begin{aligned}\nz = -n &\\;\\Longrightarrow\\; z_{\\text{ndc}} = -1 \\\\\nz = -f &\\;\\Longrightarrow\\; z_{\\text{ndc}} = +1\n\\end{aligned}",
