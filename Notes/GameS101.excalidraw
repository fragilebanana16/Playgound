    {
      "type": "text",
      "version": 1555,
      "versionNonce": 1968883426,
      "index": "bGj",
      "isDeleted": false,
      "id": "EJvlfcwqRO3tFs6rhj07K",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 10824.53950514367,
      "y": 1626.2655497278945,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e7f5ff",
      "width": 140,
