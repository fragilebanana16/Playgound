      "fontSize": 20,
      "fontFamily": 8,
      "text": "将绘制参数存放在显存 Buffer（Indirect Buffer）中，由 GPU 自身读取参数并触发渲染的 API 技术",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "将绘制参数存放在显存 Buffer（Indirect Buffer）中，由 GPU 自身读取参数并触发渲染的 API 技术",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 223,
      "versionNonce": 1540266786,
      "index": "bGd",
      "isDeleted": false,
      "id": "hdTO-qBPoNawgeuCGILAQ",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
