    {
      "type": "text",
      "version": 327,
      "versionNonce": 1601262182,
      "index": "bNn",
      "isDeleted": false,
      "id": "CKlVjzCou8gatiGPs1t0m",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 4392.089725593969,
      "y": 5881.499171168954,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "width": 488.2646822616159,
      "height": 82.421875,
      "seed": 1697412454,
      "groupIds": [
        "33oSbTJYipIplx6C65pC5"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1793845931234,
      "link": null,
      "locked": false,
      "subtype": "math",
      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{aligned} &\\text{若 } n_1 > n_2\\text{，即光密到光疏，因为有 } \\sin\\theta_2 =  \\frac{n_1}{n_2}\\sin\\theta_1 \\text{，} \\\\ &\\text{当 } \\sin\\theta_1 \\text{ 越来越大，会出现 } \\sin\\theta_2 > 1  \\text{，无解，} \\\\ &\\text{此时没有折射发生，发生全反射，}  \\text{所以形成了水下穹顶。} \\end{aligned}"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "text": "\\begin{aligned}\n&\\text{若 } n_1 > n_2\\text{，即光密到光疏，因为有 } \\sin\\theta_2 = \n\\frac{n_1}{n_2}\\sin\\theta_1 \\text{，} \\\\\n&\\text{当 } \\sin\\theta_1 \\text{ 越来越大，会出现 } \\sin\\theta_2 > 1 \n\\text{，无解，} \\\\\n&\\text{此时没有折射发生，发生全反射，} \n\\text{所以形成了水下穹顶。}\n\\end{aligned}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{aligned}\n&\\text{若 } n_1 > n_2\\text{，即光密到光疏，因为有 } \\sin\\theta_2 = \\frac{n_1}{n_2}\\sin\\theta_1 \\text{，} \\\\\n&\\text{当 } \\sin\\theta_1 \\text{ 越来越大，会出现 } \\sin\\theta_2 > 1 \\text{，无解，} \\\\\n&\\text{此时没有折射发生，发生全反射，} \\text{所以形成了水下穹顶。}\n\\end{aligned}",
      "autoResize": false,
      "lineHeight": 1.15
    },
