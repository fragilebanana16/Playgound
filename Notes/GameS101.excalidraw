          "type": "arrow"
        }
      ],
      "updated": 1790132400154,
      "link": null,
      "locked": false,
      "text": "\\begin{aligned}\n\\frac{A(-n) + B}{n} &= -1\n&\\Longrightarrow\\quad -A n + B &= -n \\\\\n\\frac{A(-f) + B}{f} &= +1\n&\\Longrightarrow\\quad -A f + B &= f\n\\end{aligned}",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{aligned}\n\\frac{A(-n) + B}{n} &= -1\n&\\Longrightarrow\\quad -A n + B &= -n \\\\\n\\frac{A(-f) + B}{f} &= +1\n&\\Longrightarrow\\quad -A f + B &= f\n\\end{aligned}",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "subtype": "math",
      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "A = -\\frac{f+n}{f-n}, \\qquad B = -\\frac{2nf}{f-n}"
      },
      "id": "niQ95QV98RX7U7rE06HmT",
      "type": "text",
