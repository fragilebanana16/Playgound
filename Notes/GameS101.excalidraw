        "mathOnly": true,
        "ariaLabel": "\\begin{pmatrix} 1&0&0&t_x\\\\ 0&1&0&t_y\\\\ 0&0&1&t_z\\\\ 0&0&0&1 \\end{pmatrix} \\begin{pmatrix} x\\\\y\\\\z\\\\1 \\end{pmatrix} = \\begin{pmatrix} x+t_x\\\\ y+t_y\\\\ z+t_z\\\\ 1 \\end{pmatrix}"
