      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{aligned} L_o(\\omega_o) &= \\int_{H^2} f_r L_i(\\omega_i) \\cos\\theta_i \\, \\mathrm{d}\\omega_i \\\\ &= f_r L_i \\int_{H^2} \\cos\\theta_i \\, \\mathrm{d}\\omega_i \\\\ &= \\pi f_r L_i \\end{aligned}"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "text": "\\begin{aligned}\nL_o(\\omega_o) &= \\int_{H^2} f_r L_i(\\omega_i) \\cos\\theta_i \\, \\mathrm{d}\\omega_i \\\\\n&= f_r L_i \\int_{H^2} \\cos\\theta_i \\, \\mathrm{d}\\omega_i \\\\\n&= \\pi f_r L_i\n\\end{aligned}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{aligned}\nL_o(\\omega_o) &= \\int_{H^2} f_r L_i(\\omega_i) \\cos\\theta_i \\, \\mathrm{d}\\omega_i \\\\\n&= f_r L_i \\int_{H^2} \\cos\\theta_i \\, \\mathrm{d}\\omega_i \\\\\n&= \\pi f_r L_i\n\\end{aligned}",
      "autoResize": true,
      "lineHeight": 1.15
    },
