      "subtype": "math",
      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{pmatrix} x'\\\\y'\\\\z'\\\\1 \\end{pmatrix} = \\begin{pmatrix} 1&0&0&t_x\\\\ 0&1&0&t_y\\\\ 0&0&1&t_z\\\\ 0&0&0&1 \\end{pmatrix} \\begin{pmatrix} x\\\\y\\\\z\\\\1 \\end{pmatrix} = \\begin{pmatrix} x+t_x\\\\ y+t_y\\\\ z+t_z\\\\ 1 \\end{pmatrix}"
      },
      "fontSize": 20,
      "fontFamily": 2,
      "text": "\\begin{pmatrix}\nx'\\\\y'\\\\z'\\\\1\n\\end{pmatrix}\n=\n\\begin{pmatrix}\n1&0&0&t_x\\\\\n0&1&0&t_y\\\\\n0&0&1&t_z\\\\\n0&0&0&1\n\\end{pmatrix}\n\\begin{pmatrix}\nx\\\\y\\\\z\\\\1\n\\end{pmatrix}\n=\n\\begin{pmatrix}\nx+t_x\\\\\ny+t_y\\\\\nz+t_z\\\\\n1\n\\end{pmatrix}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{pmatrix}\nx'\\\\y'\\\\z'\\\\1\n\\end{pmatrix}\n=\n\\begin{pmatrix}\n1&0&0&t_x\\\\\n0&1&0&t_y\\\\\n0&0&1&t_z\\\\\n0&0&0&1\n\\end{pmatrix}\n\\begin{pmatrix}\nx\\\\y\\\\z\\\\1\n\\end{pmatrix}\n=\n\\begin{pmatrix}\nx+t_x\\\\\ny+t_y\\\\\nz+t_z\\\\\n1\n\\end{pmatrix}",
      "autoResize": true,
      "lineHeight": 1.15
