    {
      "type": "text",
      "version": 13,
      "versionNonce": 1352168093,
      "index": "bBp",
      "isDeleted": false,
      "id": "Q0QJ8sGu7mZcC9TkaPzG0",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 7137.599276436135,
      "y": 1734.4934997531104,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "width": 663,
      "height": 340,
      "seed": 826152477,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790749487492,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 8,
      "text": "// 传统写法\nglGenBuffers(1, &vbo);\nglGenVertexArrays(1, &vao);\n\nglBindVertexArray(vao);\nglBindBuffer(GL_ARRAY_BUFFER, vbo);\nglBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW);\n\n// 插槽 0：位置\nglVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 24, (void*)0);\nglEnableVertexAttribArray(0);\n\n// 插槽 1：颜色\nglVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, 24, (void*)12);\nglEnableVertexAttribArray(1);\n\nglBindVertexArray(0);",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// 传统写法\nglGenBuffers(1, &vbo);\nglGenVertexArrays(1, &vao);\n\nglBindVertexArray(vao);\nglBindBuffer(GL_ARRAY_BUFFER, vbo);\nglBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW);\n\n// 插槽 0：位置\nglVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 24, (void*)0);\nglEnableVertexAttribArray(0);\n\n// 插槽 1：颜色\nglVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, 24, (void*)12);\nglEnableVertexAttribArray(1);\n\nglBindVertexArray(0);",
      "autoResize": true,
      "lineHeight": 1.25
    },
