      "isDeleted": false,
      "boundElements": null,
      "updated": 1789991268123,
      "link": null,
      "locked": false,
      "text": "就是给原来的坐标多加一个维度，并且允\n许整体按比例缩放，仍然表示同一个点",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "就是给原来的坐标多加一个维度，并且允许整体按比例缩放，仍然表示同一个点",
      "autoResize": false,
      "lineHeight": 1.35
    },
