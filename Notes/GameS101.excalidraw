      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{bmatrix} m_{11} & m_{12} & m_{13} & m_{14} \\\\[6pt] m_{21} & m_{22} & m_{23} & m_{24} \\\\[6pt] m_{31} & m_{32} & m_{33} & m_{34} \\\\[6pt] m_{41} & m_{42} & m_{43} & m_{44} \\end{bmatrix} \\begin{bmatrix} x \\\\[6pt] y \\\\[6pt] z \\\\[6pt] 1 \\end{bmatrix} = \\begin{bmatrix} m_{11}x + m_{12}y + m_{13}z + m_{14} \\\\[6pt] m_{21}x + m_{22}y + m_{23}z + m_{24} \\\\[6pt] m_{31}x + m_{32}y + m_{33}z + m_{34} \\\\[6pt] m_{41}x + m_{42}y + m_{43}z + m_{44} \\end{bmatrix}"
      },
      "fontSize": 20,
      "fontFamily": 2,
      "text": "\\begin{bmatrix}\nm_{11} & m_{12} & m_{13} & m_{14} \\\\[6pt]\nm_{21} & m_{22} & m_{23} & m_{24} \\\\[6pt]\nm_{31} & m_{32} & m_{33} & m_{34} \\\\[6pt]\nm_{41} & m_{42} & m_{43} & m_{44}\n\\end{bmatrix}\n\\begin{bmatrix}\nx \\\\[6pt]\ny \\\\[6pt]\nz \\\\[6pt]\n1\n\\end{bmatrix}\n=\n\\begin{bmatrix}\nm_{11}x + m_{12}y + m_{13}z + m_{14} \\\\[6pt]\nm_{21}x + m_{22}y + m_{23}z + m_{24} \\\\[6pt]\nm_{31}x + m_{32}y + m_{33}z + m_{34} \\\\[6pt]\nm_{41}x + m_{42}y + m_{43}z + m_{44}\n\\end{bmatrix}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{bmatrix}\nm_{11} & m_{12} & m_{13} & m_{14} \\\\[6pt]\nm_{21} & m_{22} & m_{23} & m_{24} \\\\[6pt]\nm_{31} & m_{32} & m_{33} & m_{34} \\\\[6pt]\nm_{41} & m_{42} & m_{43} & m_{44}\n\\end{bmatrix}\n\\begin{bmatrix}\nx \\\\[6pt]\ny \\\\[6pt]\nz \\\\[6pt]\n1\n\\end{bmatrix}\n=\n\\begin{bmatrix}\nm_{11}x + m_{12}y + m_{13}z + m_{14} \\\\[6pt]\nm_{21}x + m_{22}y + m_{23}z + m_{24} \\\\[6pt]\nm_{31}x + m_{32}y + m_{33}z + m_{34} \\\\[6pt]\nm_{41}x + m_{42}y + m_{43}z + m_{44}\n\\end{bmatrix}",
