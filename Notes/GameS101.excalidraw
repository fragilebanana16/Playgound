        "mathOnly": true,
        "ariaLabel": "P_{\\text{ortho}} = \\begin{bmatrix} \\dfrac{2}{r-l} & 0 & 0 & -\\dfrac{r+l}{r-l} \\\\[10pt] 0 & \\dfrac{2}{t-b} & 0 & -\\dfrac{t+b}{t-b} \\\\[10pt] 0 & 0 & -\\dfrac{2}{f-n} & -\\dfrac{f+n}{f-n} \\\\[10pt] 0 & 0 & 0 & 1 \\end{bmatrix}"
      },
      "fontSize": 20,
      "fontFamily": 2,
      "text": "P_{\\text{ortho}} =\n\\begin{bmatrix}\n\\dfrac{2}{r-l} & 0 & 0 & -\\dfrac{r+l}{r-l} \\\\[10pt]\n0 & \\dfrac{2}{t-b} & 0 & -\\dfrac{t+b}{t-b} \\\\[10pt]\n0 & 0 & -\\dfrac{2}{f-n} & -\\dfrac{f+n}{f-n} \\\\[10pt]\n0 & 0 & 0 & 1\n\\end{bmatrix}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P_{\\text{ortho}} =\n\\begin{bmatrix}\n\\dfrac{2}{r-l} & 0 & 0 & -\\dfrac{r+l}{r-l} \\\\[10pt]\n0 & \\dfrac{2}{t-b} & 0 & -\\dfrac{t+b}{t-b} \\\\[10pt]\n0 & 0 & -\\dfrac{2}{f-n} & -\\dfrac{f+n}{f-n} \\\\[10pt]\n0 & 0 & 0 & 1\n\\end{bmatrix}",
      "autoResize": true,
      "lineHeight": 1.15
