      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "L_o(x,\\omega_o) = L_e(x,\\omega_o) + \\int_{\\Omega} f_r(x,\\omega_i,\\omega_o)\\, L_i(x,\\omega_i)\\cos\\theta_i \\, d\\omega_i"
      },
      "fontSize": 20,
      "fontFamily": 2,
      "text": "L_o(x,\\omega_o) = L_e(x,\\omega_o) + \\int_{\\Omega} f_r(x,\\omega_i,\\omega_o)\\, L_i(x,\\omega_i)\\cos\\theta_i \\, d\\omega_i",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L_o(x,\\omega_o) = L_e(x,\\omega_o) + \\int_{\\Omega} f_r(x,\\omega_i,\\omega_o)\\, L_i(x,\\omega_i)\\cos\\theta_i \\, d\\omega_i",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "type": "text",
      "version": 163,
      "versionNonce": 2055244833,
      "index": "bMd",
      "isDeleted": false,
      "id": "T2PSRNtoIRGwjlTTuWXc0",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 4448.71196796953,
      "y": 4876.74922427787,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffec99",
      "width": 606.765625,
      "height": 159.265625,
