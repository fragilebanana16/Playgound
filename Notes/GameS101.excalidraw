    {
      "subtype": "math",
      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{aligned} \\frac{x'}{x} &= \\frac{-n}{z} &\\Longrightarrow\\quad x' &= -\\frac{n}{z}\\,x \\\\ \\frac{y'}{y} &= \\frac{-n}{z} &\\Longrightarrow\\quad y' &= -\\frac{n}{z}\\,y \\end{aligned}"
