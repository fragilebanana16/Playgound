      "roundness": null,
      "boundElements": [],
      "updated": 1792033552967,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 8,
      "text": "CPU 每帧遍历数据并传给 GPU效率低，间接通过绘制参数常驻/生成于显存",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CPU 每帧遍历数据并传给 GPU效率低，间接通过绘制参数常驻/生成于显存",
      "autoResize": true,
      "lineHeight": 1.25
    },
