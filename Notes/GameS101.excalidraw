      "boundElements": null,
      "updated": 1789993242449,
      "link": null,
      "locked": false,
      "text": "\\begin{pmatrix}\n1&0&0&t_x\\\\\n0&1&0&t_y\\\\\n0&0&1&t_z\\\\\n0&0&0&1\n\\end{pmatrix}\n\\begin{pmatrix}\nx\\\\y\\\\z\\\\1\n\\end{pmatrix}\n=\n\\begin{pmatrix}\nx+t_x\\\\\ny+t_y\\\\\nz+t_z\\\\\n1\n\\end{pmatrix}",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{pmatrix}\n1&0&0&t_x\\\\\n0&1&0&t_y\\\\\n0&0&1&t_z\\\\\n0&0&0&1\n\\end{pmatrix}\n\\begin{pmatrix}\nx\\\\y\\\\z\\\\1\n\\end{pmatrix}\n=\n\\begin{pmatrix}\nx+t_x\\\\\ny+t_y\\\\\nz+t_z\\\\\n1\n\\end{pmatrix}",
