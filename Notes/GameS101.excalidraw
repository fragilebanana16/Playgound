      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{aligned} E_1 &= \\Delta U_1 \\mathbf{T} + \\Delta V_1 \\mathbf{B} \\\\ E_2 &= \\Delta U_2 \\mathbf{T} + \\Delta V_2 \\mathbf{B} \\end{aligned}"
      },
      "fontSize": 16,
      "fontFamily": 2,
      "text": "\\begin{aligned}\nE_1 &= \\Delta U_1 \\mathbf{T} + \\Delta V_1 \\mathbf{B} \\\\\nE_2 &= \\Delta U_2 \\mathbf{T} + \\Delta V_2 \\mathbf{B}\n\\end{aligned}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\begin{aligned}\nE_1 &= \\Delta U_1 \\mathbf{T} + \\Delta V_1 \\mathbf{B} \\\\\nE_2 &= \\Delta U_2 \\mathbf{T} + \\Delta V_2 \\mathbf{B}\n\\end{aligned}",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "type": "text",
