      "link": null,
      "locked": false,
      "text": "\\begin{aligned}\nz = -n &\\;\\Longrightarrow\\; z_{\\text{ndc}} = -1 \\\\\nz = -f &\\;\\Longrightarrow\\; z_{\\text{ndc}} = +1\n\\end{aligned}",
      "fontSize": 16,
