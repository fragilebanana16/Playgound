      "fontFamily": 5,
      "text": "怎么判断像素在不在三角形里？",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "0E6SRaXvkUW75lT6K_B94",
      "originalText": "怎么判断像素在不在三角形里？",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 171,
      "versionNonce": 715171070,
      "index": "b7j",
      "isDeleted": false,
      "id": "A_llWvt4IX1vHelx-aXti",
      "fillStyle": "hachure",
      "strokeWidth": 1,
