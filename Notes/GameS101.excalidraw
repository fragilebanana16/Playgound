    {
      "type": "text",
      "version": 62,
      "versionNonce": 900808316,
      "index": "bFe",
      "isDeleted": false,
      "id": "XLzZGa2r0QetpMS_rf3gB",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 10035.676031752118,
      "y": 1921.0909017326153,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "width": 344,
      "height": 172.8,
      "seed": 1320306756,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1791818769700,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 6,
      "text": "typedef struct VERTEX_t\n{\n    vmath::vec4  position;   // 偏移 0，16 字节\n    vmath::vec3  normal;     // 偏移 16，12 字节\n    vmath::vec2  tex_coord;  // 偏移 28，8 字节\n    GLubyte      color[3];   // 偏移 36，3 字节\n    int          material_id;// 偏移 40，4 字节\n} VERTEX;",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "typedef struct VERTEX_t\n{\n    vmath::vec4  position;   // 偏移 0，16 字节\n    vmath::vec3  normal;     // 偏移 16，12 字节\n    vmath::vec2  tex_coord;  // 偏移 28，8 字节\n    GLubyte      color[3];   // 偏移 36，3 字节\n    int          material_id;// 偏移 40，4 字节\n} VERTEX;",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "type": "text",
      "version": 167,
      "versionNonce": 1771232068,
      "index": "bFf",
      "isDeleted": false,
      "id": "Tf_dyMJ1lix8bplHMN4JD",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 9928.496193641393,
      "y": 2179.5631170573342,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "width": 377,
      "height": 312.21112908688923,
      "seed": 1279292100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [
        {
          "id": "8-O1MZUZ8oPFzxwHvji1C",
          "type": "arrow"
        }
      ],
      "updated": 1791819028333,
      "link": null,
      "locked": false,
      "fontSize": 10.512159228514788,
      "fontFamily": 6,
      "text": "glBindVertexArray(vao);\nglBindBuffer(GL_ARRAY_BUFFER, vbo);\n\n// position\nglVertexAttribPointer(0, 4, GL_FLOAT, GL_FALSE, 44, (void*)0);\nglEnableVertexAttribArray(0);\n\n// normal\nglVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, 44, (void*)16);\nglEnableVertexAttribArray(1);\n\n// tex_coord\nglVertexAttribPointer(2, 2, GL_FLOAT, GL_FALSE, 44, (void*)28);\nglEnableVertexAttribArray(2);\n\n// color（整数，归一化）\nglVertexAttribPointer(4, 3, GL_UNSIGNED_BYTE, GL_TRUE, 44, (void*)36);\nglEnableVertexAttribArray(4);\n\n// material_id（整数，不能归一化，用 I 版本）\nglVertexAttribIPointer(5, 1, GL_INT, 44, (void*)40);\nglEnableVertexAttribArray(5);",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "glBindVertexArray(vao);\nglBindBuffer(GL_ARRAY_BUFFER, vbo);\n\n// position\nglVertexAttribPointer(0, 4, GL_FLOAT, GL_FALSE, 44, (void*)0);\nglEnableVertexAttribArray(0);\n\n// normal\nglVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, 44, (void*)16);\nglEnableVertexAttribArray(1);\n\n// tex_coord\nglVertexAttribPointer(2, 2, GL_FLOAT, GL_FALSE, 44, (void*)28);\nglEnableVertexAttribArray(2);\n\n// color（整数，归一化）\nglVertexAttribPointer(4, 3, GL_UNSIGNED_BYTE, GL_TRUE, 44, (void*)36);\nglEnableVertexAttribArray(4);\n\n// material_id（整数，不能归一化，用 I 版本）\nglVertexAttribIPointer(5, 1, GL_INT, 44, (void*)40);\nglEnableVertexAttribArray(5);",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "type": "text",
      "version": 215,
      "versionNonce": 901878140,
      "index": "bFg",
      "isDeleted": false,
      "id": "XNtnrWm2Rn1PQjl7LZUIo",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 10316.186335361863,
      "y": 2178.8557897492137,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "width": 395.78617292052877,
      "height": 382.25361386149507,
      "seed": 1114367484,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1791818929760,
      "link": null,
      "locked": false,
      "fontSize": 11.326033003303559,
      "fontFamily": 6,
      "text": "glBindVertexArray(vao);\n\n// ---- 1. 配置格式（每个插槽各一次）----\nglVertexAttribFormat(0, 4, GL_FLOAT, GL_FALSE, 0);              // position\nglVertexAttribFormat(1, 3, GL_FLOAT, GL_FALSE, 16);             // normal\nglVertexAttribFormat(2, 2, GL_FLOAT, GL_FALSE, 28);             // tex_coord\nglVertexAttribFormat(4, 3, GL_UNSIGNED_BYTE, GL_TRUE, 36);      // color\nglVertexAttribIFormat(5, 1, GL_INT, 40);                        // material_id\n\n// ---- 2. 关联到绑定组（每个插槽各一次）----\nglVertexAttribBinding(0, 0);   // position → 组 0\nglVertexAttribBinding(1, 0);   // normal   → 组 0\nglVertexAttribBinding(2, 0);   // tex_coord → 组 0\nglVertexAttribBinding(4, 0);   // color    → 组 0\nglVertexAttribBinding(5, 0);   // material_id → 组 0\n\n// ---- 3. 绑定来源（只写一次！）----\nglBindVertexBuffer(0, vbo, 0, 44);   // 组 0 的 VBO、偏移、步长\n\n// ---- 4. 启用插槽 ----\nglEnableVertexAttribArray(0);\nglEnableVertexAttribArray(1);\nglEnableVertexAttribArray(2);\nglEnableVertexAttribArray(4);\nglEnableVertexAttribArray(5);",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "glBindVertexArray(vao);\n\n// ---- 1. 配置格式（每个插槽各一次）----\nglVertexAttribFormat(0, 4, GL_FLOAT, GL_FALSE, 0);              // position\nglVertexAttribFormat(1, 3, GL_FLOAT, GL_FALSE, 16);             // normal\nglVertexAttribFormat(2, 2, GL_FLOAT, GL_FALSE, 28);             // tex_coord\nglVertexAttribFormat(4, 3, GL_UNSIGNED_BYTE, GL_TRUE, 36);      // color\nglVertexAttribIFormat(5, 1, GL_INT, 40);                        // material_id\n\n// ---- 2. 关联到绑定组（每个插槽各一次）----\nglVertexAttribBinding(0, 0);   // position → 组 0\nglVertexAttribBinding(1, 0);   // normal   → 组 0\nglVertexAttribBinding(2, 0);   // tex_coord → 组 0\nglVertexAttribBinding(4, 0);   // color    → 组 0\nglVertexAttribBinding(5, 0);   // material_id → 组 0\n\n// ---- 3. 绑定来源（只写一次！）----\nglBindVertexBuffer(0, vbo, 0, 44);   // 组 0 的 VBO、偏移、步长\n\n// ---- 4. 启用插槽 ----\nglEnableVertexAttribArray(0);\nglEnableVertexAttribArray(1);\nglEnableVertexAttribArray(2);\nglEnableVertexAttribArray(4);\nglEnableVertexAttribArray(5);",
      "autoResize": true,
      "lineHeight": 1.35
    },
