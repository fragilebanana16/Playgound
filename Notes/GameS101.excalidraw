      "fontSize": 16,
      "fontFamily": 8,
      "text": "void glCopyBufferSubData(\n    GLenum readTarget,   // 源缓冲区所在的绑定点\n    GLenum writeTarget,  // 目标缓冲区所在的绑定点\n    GLintptr readOffset, // 源偏移\n    GLintptr writeOffset,// 目标偏移\n    GLsizeiptr size      // 拷贝多少字节\n);",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void glCopyBufferSubData(\n    GLenum readTarget,   // 源缓冲区所在的绑定点\n    GLenum writeTarget,  // 目标缓冲区所在的绑定点\n    GLintptr readOffset, // 源偏移\n    GLintptr writeOffset,// 目标偏移\n    GLsizeiptr size      // 拷贝多少字节\n);",
      "autoResize": true,
      "lineHeight": 1.25
    },
