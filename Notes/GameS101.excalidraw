        }
      ],
      "updated": 1791471815830,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 8,
      "text": "BindBuffer：绑定目标，以便推送数据给着色器\nBindBufferBase：绑到编号，着色器自己取",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BindBuffer：绑定目标，以便推送数据给着色器\nBindBufferBase：绑到编号，着色器自己取",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 137,
      "versionNonce": 45682215,
      "index": "bDU",
      "isDeleted": false,
      "id": "BXiWejszKnF5lYKuyyZLP",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 9033.931204223734,
      "y": 974.6856160263665,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "width": 469,
      "height": 220,
      "seed": 1145628073,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [
        {
          "id": "lbdVqD6QpHv0IHlSGzghp",
          "type": "arrow"
        }
      ],
      "updated": 1791471815830,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 8,
      "text": "// 着色器\nlayout (binding = 0, std430) buffer DataBlock\n{\n    vec4 values[];\n};\n\nvoid main()\n{\n    values[gl_VertexID] = vec4(aPos, 1.0);   // 写\n    gl_Position = vec4(aPos, 1.0);\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// 着色器\nlayout (binding = 0, std430) buffer DataBlock\n{\n    vec4 values[];\n};\n\nvoid main()\n{\n    values[gl_VertexID] = vec4(aPos, 1.0);   // 写\n    gl_Position = vec4(aPos, 1.0);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 213,
      "versionNonce": 901800007,
      "index": "bDV",
      "isDeleted": false,
      "id": "WJZhUqNYG0MHAjj1lvp4B",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 9032.889008482507,
      "y": 1251.5397229322723,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "width": 637,
      "height": 260,
      "seed": 1272280999,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1791471803151,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 8,
      "text": "// C++\nGLuint ssbo;\nglGenBuffers(1, &ssbo);\nglBindBuffer(GL_SHADER_STORAGE_BUFFER, ssbo);\nglBufferData(GL_SHADER_STORAGE_BUFFER, size, nullptr, GL_DYNAMIC_DRAW);\nglBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, ssbo);   // 绑定点 0\n\n// 读回着色器写的数据\nglBindBuffer(GL_SHADER_STORAGE_BUFFER, ssbo);\nfloat* ptr = (float*)glMapBufferRange(\n    GL_SHADER_STORAGE_BUFFER, 0, size, GL_MAP_READ_BIT);\n// 读 ptr\nglUnmapBuffer(GL_SHADER_STORAGE_BUFFER);",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// C++\nGLuint ssbo;\nglGenBuffers(1, &ssbo);\nglBindBuffer(GL_SHADER_STORAGE_BUFFER, ssbo);\nglBufferData(GL_SHADER_STORAGE_BUFFER, size, nullptr, GL_DYNAMIC_DRAW);\nglBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, ssbo);   // 绑定点 0\n\n// 读回着色器写的数据\nglBindBuffer(GL_SHADER_STORAGE_BUFFER, ssbo);\nfloat* ptr = (float*)glMapBufferRange(\n    GL_SHADER_STORAGE_BUFFER, 0, size, GL_MAP_READ_BIT);\n// 读 ptr\nglUnmapBuffer(GL_SHADER_STORAGE_BUFFER);",
      "autoResize": true,
      "lineHeight": 1.25
    },
