      "fontSize": 20,
      "fontFamily": 5,
      "text": "怎么判断像素在不在三角形里？",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "0E6SRaXvkUW75lT6K_B94",
      "originalText": "怎么判断像素在不在三角形里？",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 171,
      "versionNonce": 715171070,
      "index": "b7j",
      "isDeleted": false,
      "id": "A_llWvt4IX1vHelx-aXti",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 1681.9107286457402,
      "y": 2059.4009464746405,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "width": 218,
      "height": 100,
      "seed": 825056958,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [
        {
          "id": "E1POVrtjMObROysx3-POd",
          "type": "arrow"
        }
      ],
      "updated": 1790154503927,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 5,
      "text": "边 AB 和点 P：算 AB × AP\n边 BC 和点 P：算 BC × BP\n边 CA 和点 P：算 CA × CP\n\n三个结果同号 → 点在三角形内",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "边 AB 和点 P：算 AB × AP\n边 BC 和点 P：算 BC × BP\n边 CA 和点 P：算 CA × CP\n\n三个结果同号 → 点在三角形内",
      "autoResize": true,
      "lineHeight": 1.25
    },
