    {
      "type": "text",
      "version": 156,
      "versionNonce": 1765323128,
      "index": "bER",
      "isDeleted": false,
      "id": "IBpizOQUFUGm6tvuS43Kb",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 9000.549094635671,
      "y": 2596.7790741232047,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "width": 224,
      "height": 120,
      "seed": 1496583032,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1791795115349,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 8,
      "text": "// 必须一起链接\nglAttachShader(prog, vs);\nglAttachShader(prog, fs);\nglLinkProgram(prog);\n\nglUseProgram(prog);",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// 必须一起链接\nglAttachShader(prog, vs);\nglAttachShader(prog, fs);\nglLinkProgram(prog);\n\nglUseProgram(prog);",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 42,
      "versionNonce": 948530808,
      "index": "bES",
      "isDeleted": false,
      "id": "pn4UxTGZY5ZNO2yd-sXO2",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 9300.599604425885,
      "y": 2594.7223281934307,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "width": 539,
      "height": 340,
      "seed": 804398600,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1791794813504,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 8,
      "text": "// 顶点单独链接\nglAttachShader(vprog, vs);\nglProgramParameteri(vprog, GL_PROGRAM_SEPARABLE, GL_TRUE);\nglLinkProgram(vprog);\n\n// 片段单独链接\nglAttachShader(fprog, fs);\nglProgramParameteri(fprog, GL_PROGRAM_SEPARABLE, GL_TRUE);\nglLinkProgram(fprog);\n\n// 运行时拼起来\nglGenProgramPipelines(1, &pipeline);\nglBindProgramPipeline(pipeline);\nglUseProgramStages(pipeline, GL_VERTEX_SHADER_BIT,   vprog);\nglUseProgramStages(pipeline, GL_FRAGMENT_SHADER_BIT, fprog);\n\nglDrawArrays(...);",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// 顶点单独链接\nglAttachShader(vprog, vs);\nglProgramParameteri(vprog, GL_PROGRAM_SEPARABLE, GL_TRUE);\nglLinkProgram(vprog);\n\n// 片段单独链接\nglAttachShader(fprog, fs);\nglProgramParameteri(fprog, GL_PROGRAM_SEPARABLE, GL_TRUE);\nglLinkProgram(fprog);\n\n// 运行时拼起来\nglGenProgramPipelines(1, &pipeline);\nglBindProgramPipeline(pipeline);\nglUseProgramStages(pipeline, GL_VERTEX_SHADER_BIT,   vprog);\nglUseProgramStages(pipeline, GL_FRAGMENT_SHADER_BIT, fprog);\n\nglDrawArrays(...);",
      "autoResize": true,
      "lineHeight": 1.25
    },
