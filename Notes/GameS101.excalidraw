      "originalText": "\\begin{aligned}\nz = -n &\\;\\Longrightarrow\\; z_{\\text{ndc}} = -1 \\\\\nz = -f &\\;\\Longrightarrow\\; z_{\\text{ndc}} = +1\n\\end{aligned}",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "subtype": "math",
      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{aligned} \\frac{A(-n) + B}{n} &= -1 &\\Longrightarrow\\quad -A n + B &= -n \\\\ \\frac{A(-f) + B}{f} &= +1 &\\Longrightarrow\\quad -A f + B &= f \\end{aligned}"
      },
      "id": "uheta0OdSFum-_FRAe0e0",
      "type": "text",
      "x": 1947.0722342481886,
      "y": 2370.7970194578056,
      "width": 361.140625,
      "height": 87.015625,
      "angle": 0,
