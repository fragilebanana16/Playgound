    {
      "subtype": "math",
      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{aligned} x_{\\text{clip}} &= \\frac{2}{r-l}\\,x + 0\\cdot y + 0\\cdot z - \\frac{r+l}{r-l}\\cdot 1 \\\\[6pt] y_{\\text{clip}} &= 0\\cdot x + \\frac{2}{t-b}\\,y + 0\\cdot z - \\frac{t+b}{t-b}\\cdot 1 \\\\[6pt] z_{\\text{clip}} &= 0\\cdot x + 0\\cdot y - \\frac{2}{f-n}\\,z - \\frac{f+n}{f-n}\\cdot 1 \\\\[6pt] w_{\\text{clip}} &= 0\\cdot x + 0\\cdot y + 0\\cdot z + 1\\cdot 1 \\end{aligned}"
      },
      "id": "pmBDajVhpzXXng7VetBly",
      "type": "text",
      "x": 3150.339082736547,
      "y": 1825.8800516815627,
      "width": 404.65625,
      "height": 232.6875,
      "angle": 0,
