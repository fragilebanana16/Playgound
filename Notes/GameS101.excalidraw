      "customData": {
        "useTex": true,
        "mathOnly": true,
        "ariaLabel": "\\begin{aligned} t &= n \\tan\\!\\left(\\frac{\\text{fov}}{2}\\right) &\\Longrightarrow\\quad \\frac{n}{t} &= \\frac{1}{\\tan(\\text{fov}/2)} =  \\cot\\!\\left(\\frac{\\text{fov}}{2}\\right) \\\\ r &= t \\cdot \\text{aspect} &\\Longrightarrow\\quad \\frac{n}{r} &= \\frac{1}{\\text{aspect}\\cdot\\tan(\\text{fov}/2)} \\end{aligned}"
      },
